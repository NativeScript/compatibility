{
  "name": "nativescript-compatibility",
  "version": "0.1.0",
  "private": true,
  "description": "compatibility.nativescript.org: computed compatibility matrix and advisories for NativeScript runtimes and tooling.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types",
    "check": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vueuse/core": "^14.4.0"
  }
}
