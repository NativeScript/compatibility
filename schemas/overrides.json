{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://compatibility.nativescript.org/v1/schemas/overrides.json",
	"title": "Compatibility override entry",
	"description": "One maintainer-curated entry under data/overrides/, named <timestamp>_<slug>.json. Entries apply in file-name order, so a later timestamp wins where two overlap. Either a requirements override for package versions that publish none (or publish a wrong bound), or an advisory about a break discovered after publication.",
	"oneOf": [
		{
			"$ref": "#/definitions/requirementsOverride"
		},
		{
			"$ref": "#/definitions/advisory"
		}
	],
	"definitions": {
		"requirementsOverride": {
			"type": "object",
			"required": [
				"kind",
				"package",
				"versions",
				"set"
			],
			"additionalProperties": false,
			"properties": {
				"$schema": {
					"type": "string"
				},
				"kind": {
					"const": "requirements"
				},
				"package": {
					"type": "string"
				},
				"versions": {
					"type": "string",
					"description": "Semver range of package versions the override applies to."
				},
				"set": {
					"$ref": "https://compatibility.nativescript.org/v1/schemas/requirements.json"
				},
				"note": {
					"type": "string"
				}
			}
		},
		"advisory": {
			"type": "object",
			"required": [
				"kind",
				"id",
				"package",
				"affects",
				"when",
				"severity",
				"message"
			],
			"additionalProperties": false,
			"properties": {
				"$schema": {
					"type": "string"
				},
				"kind": {
					"const": "advisory"
				},
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]*$"
				},
				"package": {
					"type": "string"
				},
				"affects": {
					"type": "string",
					"description": "Semver range of affected package versions."
				},
				"when": {
					"$ref": "https://compatibility.nativescript.org/v1/schemas/requirements.json",
					"description": "Toolchain conditions; every listed range must match."
				},
				"severity": {
					"enum": [
						"error",
						"warn"
					]
				},
				"message": {
					"type": "string"
				},
				"fix": {
					"type": "string"
				},
				"url": {
					"type": "string",
					"format": "uri"
				}
			}
		}
	}
}
