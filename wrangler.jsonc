{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nativescript-compatibility",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-09",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true, "head_sampling_rate": 1 },
	"assets": {
		// The Vite plugin points this at the client build; requests matching no asset reach the Worker.
		"not_found_handling": "none"
	},
	"kv_namespaces": [
		{ "binding": "COMPAT_KV", "id": "ed0d40f462c842399a720b35a02ebce0" }
	],
	"routes": [{ "pattern": "compatibility.nativescript.org", "custom_domain": true }],
	"triggers": { "crons": ["0 * * * *"] },
	"vars": {
		"NPM_REGISTRY": "https://registry.npmjs.org/"
	}
}
