{
	"$schema": "../schemas/overrides.json",
	"requirements": [
		{
			"package": "@nativescript/android",
			"versions": ">=8.6.0",
			"set": {
				"compileSdk": ">=28",
				"buildTools": ">=23",
				"jdk": ">=17"
			},
			"note": "Runtimes before the requirements block existed; matches the CLI's built-in defaults."
		},
		{
			"package": "@nativescript/android",
			"versions": ">=8.2.0 <8.6.0",
			"set": {
				"compileSdk": ">=28",
				"buildTools": ">=23",
				"jdk": ">=1.8"
			}
		},
		{
			"package": "@nativescript/android",
			"versions": "<8.2.0",
			"set": {
				"compileSdk": ">=28 <=30",
				"buildTools": ">=23 <=30",
				"jdk": ">=1.8"
			}
		},
		{
			"package": "@nativescript/ios",
			"versions": "*",
			"set": {
				"xcode": ">=10",
				"cocoapods": ">=1.0.0"
			},
			"note": "The 2.x doctor minimums; only applied where a runtime publishes nothing."
		}
	],
	"advisories": [
		{
			"id": "example-ios-xcode-27",
			"package": "@nativescript/ios",
			"affects": "<9.2.0",
			"when": {
				"xcode": ">=27"
			},
			"severity": "warn",
			"message": "Xcode 27 has not been verified with this runtime line. Placeholder advisory for the prototype.",
			"fix": "Update to the latest @nativescript/ios once a verified release is listed here.",
			"url": "https://github.com/NativeScript/ios/issues"
		}
	]
}
